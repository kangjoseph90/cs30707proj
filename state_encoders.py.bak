"""State representation encoders for Snake.

Encoders that transform a canonical ``SnakeState`` into a flat
float32 vector suitable for an MLP:

Phase 1:
* ``FullStateEncoder``              – one-hot per body segment on the full grid
* ``StructuralStateEncoder``        – lossless compression using body-path directions
* ``LocalSparseOrderedStateEncoder`` – ordered local window around the head

Phase 4 (spatial ablation):
* ``DenseOrderedGlobalEncoder``     – dense occupancy + order on full grid
* ``DenseOrderedLocalEncoder``      – dense occupancy + order in local window
* ``OccupancyGlobalEncoder``        – dense occupancy (no order) on full grid
* ``OccupancyLocalEncoder``         – dense occupancy (no order) in local window
"""

from __future__ import annotations

from abc import ABC, abstractmethod
from typing import Optional

import numpy as np

from snake_env import DELTA, SnakeState

# Direction-to-index map for fast lookup in structural encoder
_DELTA_TO_IDX: dict[tuple[int, int], int] = {
    (1, 0): 0,   # Right
    (0, 1): 1,   # Down
    (-1, 0): 2,  # Left
    (0, -1): 3,  # Up
}


# ---------------------------------------------------------------------------
# Abstract base
# ---------------------------------------------------------------------------

class StateEncoder(ABC):
    """Encode a ``SnakeState`` into a flat float32 vector."""

    @property
    @abstractmethod
    def output_dim(self) -> int:
        ...

    @abstractmethod
    def encode(self, state: SnakeState) -> np.ndarray:
        """Return a float32 vector of length ``self.output_dim``."""
        ...


# ---------------------------------------------------------------------------
# 1. Full State Representation
# ---------------------------------------------------------------------------

class FullStateEncoder(StateEncoder):
    """One-hot per body-segment position on the full grid + fruit + direction.

    Layout (flat vector):
        body segments : board_size² × max_length   (one-hot, zero-padded)
        fruit         : board_size²                 (one-hot)
        direction     : 4                           (one-hot)
    """

    def __init__(self, board_size: int = 15, max_length: int = 100):
        self.board_size = board_size
        self.max_length = max_length
        self._bsq = board_size * board_size

    @property
    def output_dim(self) -> int:
        return self._bsq * self.max_length + self._bsq + 4

    def encode(self, state: SnakeState) -> np.ndarray:
        bs = self.board_size
        bsq = self._bsq
        out = np.zeros(self.output_dim, dtype=np.float32)

        # Body segments
        for i, seg in enumerate(state.body):
            if i >= self.max_length:
                break
            idx = seg[0] * bs + seg[1]
            out[i * bsq + idx] = 1.0

        # Fruit
        offset_body = bsq * self.max_length
        out[offset_body + state.fruit[0] * bs + state.fruit[1]] = 1.0

        # Direction
        offset_fruit = offset_body + bsq
        out[offset_fruit + state.direction] = 1.0

        return out


# ---------------------------------------------------------------------------
# 2. Structural State Representation
# ---------------------------------------------------------------------------

class StructuralStateEncoder(StateEncoder):
    """Lossless compression using head/fruit one-hot + body-path directions.

    Layout (flat vector):
        head       : board_size²              (one-hot)
        fruit      : board_size²              (one-hot)
        body_path  : 4 × (max_length - 1)     (direction one-hot, zero-padded)
        direction  : 4                        (one-hot)
    """

    def __init__(self, board_size: int = 15, max_length: int = 100):
        self.board_size = board_size
        self.max_length = max_length
        self._bsq = board_size * board_size

    @property
    def output_dim(self) -> int:
        return self._bsq + self._bsq + 4 * (self.max_length - 1) + 4

    def encode(self, state: SnakeState) -> np.ndarray:
        bs = self.board_size
        bsq = self._bsq
        out = np.zeros(self.output_dim, dtype=np.float32)

        # Head
        out[state.body[0][0] * bs + state.body[0][1]] = 1.0

        # Fruit
        offset_head = bsq
        out[offset_head + state.fruit[0] * bs + state.fruit[1]] = 1.0

        # Body path: direction from segment i to segment i+1
        offset_fruit = 2 * bsq
        max_transitions = self.max_length - 1
        for i in range(min(len(state.body) - 1, max_transitions)):
            dx = state.body[i + 1][0] - state.body[i][0]
            dy = state.body[i + 1][1] - state.body[i][1]
            dir_idx = _DELTA_TO_IDX.get((dx, dy))
            if dir_idx is not None:
                out[offset_fruit + i * 4 + dir_idx] = 1.0
            # If (dx, dy) is not a valid direction (shouldn't happen with
            # adjacent body), leave zeros for that transition.

        # Direction
        offset_path = offset_fruit + max_transitions * 4
        out[offset_path + state.direction] = 1.0

        return out


# Backward-compatible alias
LocalStateEncoder = LocalSparseOrderedStateEncoder


# ---------------------------------------------------------------------------
# Phase 4: Dense spatial encoders
# ---------------------------------------------------------------------------

def _body_rank_from_tail(
    body: tuple[tuple[int, int], ...], max_length: int,
) -> dict[tuple[int, int], int]:
    """Return ``{(x, y): rank_from_tail}`` for all body segments.

    ``rank_from_tail`` starts at 1 (tail) so that it is non-zero even for
    the tail segment.  Head gets ``len(body)``.  Used for the *ordered*
    dense encoders.

    Raises ``AssertionError`` if ``len(body) > max_length`` – silent
    truncation is never acceptable for a lossless encoder.
    """
    assert len(body) <= max_length, (
        f"body length {len(body)} exceeds max_length {max_length}"
    )
    order: dict[tuple[int, int], int] = {}
    for i, seg in enumerate(reversed(body), start=1):
        order[(seg[0], seg[1])] = i
    return order


class DenseOrderedGlobalEncoder(StateEncoder):
    """Dense global representation with body occupancy + body order + head + fruit + direction.

    Layout (flat vector):
        body_occupancy : board_size²  (1.0 where body exists, 0.0 elsewhere)
        body_order     : board_size²  (rank_from_tail / max_length, 0 for empty)
        head_grid      : board_size²  (1.0 at head, 0.0 elsewhere)
        fruit_grid     : board_size²  (1.0 at fruit, 0.0 elsewhere)
        direction      : 4             (one-hot)

    Total: 4 × 225 + 4 = **904d**.

    Lossless: body_order + head position fully determines body ordering.
    """

    def __init__(self, board_size: int = 15, max_length: int = 100):
        self.board_size = board_size
        self.max_length = max_length
        self._bsq = board_size * board_size

    @property
    def output_dim(self) -> int:
        return 4 * self._bsq + 4  # 904

    def encode(self, state: SnakeState) -> np.ndarray:
        bs = self.board_size
        bsq = self._bsq
        out = np.zeros(self.output_dim, dtype=np.float32)

        order_map = _body_rank_from_tail(state.body, self.max_length)

        for (x, y), rank in order_map.items():
            pos = x * bs + y
            out[pos] = 1.0                        # occupancy channel
            out[bsq + pos] = rank / self.max_length  # order channel

        # head channel (offset 2*bsq)
        hx, hy = state.head
        out[2 * bsq + hx * bs + hy] = 1.0

        # fruit channel (offset 3*bsq)
        out[3 * bsq + state.fruit[0] * bs + state.fruit[1]] = 1.0

        # direction (offset 4*bsq)
        out[4 * bsq + state.direction] = 1.0

        return out


class DenseOrderedLocalEncoder(StateEncoder):
    """Dense local window with body occupancy + body order + wall + fruit delta + direction.

    Layout (flat vector):
        local_body_occupancy : K²   (1.0 where body exists in window)
        local_body_order     : K²   (rank_from_tail / max_length for visible body)
        local_wall           : K²   (1.0 for out-of-bounds cells)
        fruit_dx_dy          : 2    (normalized)
        direction            : 4    (one-hot)

    Total: 3K² + 6.
        K=5: 81d,  K=7: 153d,  K=9: 249d

    NOT lossless: window discards outside information.
    """

    def __init__(
        self, board_size: int = 15, max_length: int = 100, window_size: int = 9,
    ):
        self.board_size = board_size
        self.max_length = max_length
        self.window_size = window_size
        self._k = window_size
        self._half = window_size // 2

    @property
    def output_dim(self) -> int:
        return 3 * self._k * self._k + 2 + 4

    def encode(self, state: SnakeState) -> np.ndarray:
        bs = self.board_size
        k = self._k
        half = self._half
        hx, hy = state.head
        origin_x = hx - half
        origin_y = hy - half

        out = np.zeros(self.output_dim, dtype=np.float32)
        order_map = _body_rank_from_tail(state.body, self.max_length)

        ksq = k * k
        for gy in range(k):
            for gx in range(k):
                abs_x = origin_x + gx
                abs_y = origin_y + gy
                pos = gy * k + gx

                if abs_x < 0 or abs_x >= bs or abs_y < 0 or abs_y >= bs:
                    # wall channel (channel 2, offset 2*ksq)
                    out[2 * ksq + pos] = 1.0
                else:
                    rank = order_map.get((abs_x, abs_y))
                    if rank is not None:
                        out[pos] = 1.0                    # occupancy channel
                        out[ksq + pos] = rank / self.max_length  # order channel

        # fruit dx, dy (normalized to [-1, 1])
        offset_grid = 3 * ksq
        out[offset_grid] = (state.fruit[0] - hx) / (bs - 1)
        out[offset_grid + 1] = (state.fruit[1] - hy) / (bs - 1)

        # direction
        offset_dir = offset_grid + 2
        out[offset_dir + state.direction] = 1.0

        return out


class OccupancyGlobalEncoder(StateEncoder):
    """Dense global representation WITHOUT body order.

    Layout (flat vector):
        body_occupancy : board_size²  (1.0 where body exists)
        head_grid      : board_size²  (1.0 at head)
        fruit_grid     : board_size²  (1.0 at fruit)
        direction      : 4            (one-hot)

    Total: 3 × 225 + 4 = **679d**.

    NOT lossless: different body orderings with same occupancy produce
    identical encodings.
    """

    def __init__(self, board_size: int = 15, max_length: int = 100):
        self.board_size = board_size
        self.max_length = max_length
        self._bsq = board_size * board_size

    @property
    def output_dim(self) -> int:
        return 3 * self._bsq + 4  # 679

    def encode(self, state: SnakeState) -> np.ndarray:
        bs = self.board_size
        bsq = self._bsq
        out = np.zeros(self.output_dim, dtype=np.float32)

        # occupancy channel
        for seg in state.body:
            out[seg[0] * bs + seg[1]] = 1.0

        # head channel (offset bsq)
        hx, hy = state.head
        out[bsq + hx * bs + hy] = 1.0

        # fruit channel (offset 2*bsq)
        out[2 * bsq + state.fruit[0] * bs + state.fruit[1]] = 1.0

        # direction (offset 3*bsq)
        out[3 * bsq + state.direction] = 1.0

        return out


class OccupancyLocalEncoder(StateEncoder):
    """Dense local window WITHOUT body order.

    Layout (flat vector):
        local_body_occupancy : K²   (1.0 where body exists in window)
        local_wall           : K²   (1.0 for out-of-bounds cells)
        fruit_dx_dy          : 2    (normalized)
        direction            : 4    (one-hot)

    Total: 2K² + 6.
        K=5: 56d,  K=7: 104d,  K=9: 168d

    NOT lossless: window discards outside information and body ordering.
    """

    def __init__(
        self, board_size: int = 15, max_length: int = 100, window_size: int = 9,
    ):
        self.board_size = board_size
        self.max_length = max_length
        self.window_size = window_size
        self._k = window_size
        self._half = window_size // 2

    @property
    def output_dim(self) -> int:
        return 2 * self._k * self._k + 2 + 4

    def encode(self, state: SnakeState) -> np.ndarray:
        bs = self.board_size
        k = self._k
        half = self._half
        hx, hy = state.head
        origin_x = hx - half
        origin_y = hy - half

        out = np.zeros(self.output_dim, dtype=np.float32)
        body_set = set(state.body)

        ksq = k * k
        for gy in range(k):
            for gx in range(k):
                abs_x = origin_x + gx
                abs_y = origin_y + gy
                pos = gy * k + gx

                if abs_x < 0 or abs_x >= bs or abs_y < 0 or abs_y >= bs:
                    # wall channel (channel 1, offset ksq)
                    out[ksq + pos] = 1.0
                else:
                    if (abs_x, abs_y) in body_set:
                        out[pos] = 1.0  # occupancy channel

        # fruit dx, dy
        offset_grid = 2 * ksq
        out[offset_grid] = (state.fruit[0] - hx) / (bs - 1)
        out[offset_grid + 1] = (state.fruit[1] - hy) / (bs - 1)

        # direction
        offset_dir = offset_grid + 2
        out[offset_dir + state.direction] = 1.0

        return out


# ---------------------------------------------------------------------------
# Centralized encoder factory
# ---------------------------------------------------------------------------

# Representations that require --local-window-size
WINDOW_REPRESENTATIONS = frozenset({
    "local", "local_sparse_ordered",
    "dense_ordered_local", "occupancy_local",
})


def build_encoder(
    representation: str,
    board_size: int,
    max_length: int,
    window_size: int | None = None,
) -> StateEncoder:
    """Create an encoder by representation name.

    This is the single source of truth for name → encoder mapping.
    All scripts should use this instead of building encoders directly.
    """
    if representation == "full":
        return FullStateEncoder(board_size, max_length)
    if representation == "structural":
        return StructuralStateEncoder(board_size, max_length)
    if representation in ("local", "local_sparse_ordered"):
        return LocalSparseOrderedStateEncoder(
            board_size, max_length, window_size or 7,
        )
    if representation == "dense_ordered_global":
        return DenseOrderedGlobalEncoder(board_size, max_length)
    if representation == "dense_ordered_local":
        return DenseOrderedLocalEncoder(
            board_size, max_length, window_size or 7,
        )
    if representation == "occupancy_global":
        return OccupancyGlobalEncoder(board_size, max_length)
    if representation == "occupancy_local":
        return OccupancyLocalEncoder(
            board_size, max_length, window_size or 7,
        )
    raise ValueError(f"Unknown representation: {representation}")
    vector: np.ndarray,
    board_size: int,
    max_length: int,
) -> SnakeState:
    """Decode a structural-state vector back to a ``SnakeState``.

    Returns a ``SnakeState`` with ``direction`` and full ``body``.
    ``fruit`` is reconstructed from the fruit one-hot section.
    """
    bs = board_size
    bsq = bs * bs

    # Head
    head_flat = int(np.argmax(vector[:bsq]))
    head = (head_flat // bs, head_flat % bs)

    # Fruit
    fruit_flat = int(np.argmax(vector[bsq : 2 * bsq]))
    fruit = (fruit_flat // bs, fruit_flat % bs)

    # Body path
    offset_path = 2 * bsq
    max_transitions = max_length - 1
    body = [head]
    for i in range(max_transitions):
        sl = vector[offset_path + i * 4 : offset_path + i * 4 + 4]
        if sl.max() == 0.0:
            # No more transitions
            break
        dir_idx = int(np.argmax(sl))
        dx, dy = DELTA[dir_idx]
        prev = body[-1]
        body.append((prev[0] + dx, prev[1] + dy))

    # Direction
    offset_dir = offset_path + max_transitions * 4
    direction = int(np.argmax(vector[offset_dir : offset_dir + 4]))

    return SnakeState(
        body=tuple(body),
        fruit=fruit,
        direction=direction,
    )


# ---------------------------------------------------------------------------
# 3. Local (Ordered) State Representation
# ---------------------------------------------------------------------------

class LocalSparseOrderedStateEncoder(StateEncoder):
    """Ordered local window around the head.

    Layout (flat vector):
        body channels : max_length × K²  (one-hot per segment, zero if out of window)
        wall channel  : K²               (1 for out-of-board, 0 for valid)
        fruit delta   : 2                (normalized dx, dy in [-1, 1])
        direction     : 4                (one-hot)
    """

    def __init__(
        self,
        board_size: int = 15,
        max_length: int = 100,
        window_size: int = 9,
    ):
        self.board_size = board_size
        self.max_length = max_length
        self.window_size = window_size
        self._k = window_size
        self._half = window_size // 2

    @property
    def output_dim(self) -> int:
        channels = self.max_length + 1  # body segments + wall
        return channels * self._k * self._k + 2 + 4

    def encode(self, state: SnakeState) -> np.ndarray:
        bs = self.board_size
        k = self._k
        half = self._half
        hx, hy = state.head
        origin_x = hx - half
        origin_y = hy - half

        out = np.zeros(self.output_dim, dtype=np.float32)

        # Build a mapping: (x, y) -> segment index  (only if within window)
        seg_map: dict[tuple[int, int], int] = {}
        for i, seg in enumerate(state.body):
            if i >= self.max_length:
                break
            # Position in the window grid
            wx = seg[0] - origin_x
            wy = seg[1] - origin_y
            if 0 <= wx < k and 0 <= wy < k:
                seg_map[(wx, wy)] = i

        # Fill body segment channels and wall channel
        wall_channel = self.max_length  # last channel
        for gy in range(k):
            for gx in range(k):
                abs_x = origin_x + gx
                abs_y = origin_y + gy
                pos = gy * k + gx  # row-major in the K×K grid

                # Wall channel
                if abs_x < 0 or abs_x >= bs or abs_y < 0 or abs_y >= bs:
                    out[wall_channel * k * k + pos] = 1.0
                else:
                    # Body segment at this grid position?
                    seg_idx = seg_map.get((gx, gy))
                    if seg_idx is not None:
                        out[seg_idx * k * k + pos] = 1.0

        # Fruit delta (normalized to [-1, 1])
        offset_grid = (self.max_length + 1) * k * k
        dx = (state.fruit[0] - hx) / (bs - 1)
        dy = (state.fruit[1] - hy) / (bs - 1)
        out[offset_grid] = dx
        out[offset_grid + 1] = dy

        # Direction
        offset_dir = offset_grid + 2
        out[offset_dir + state.direction] = 1.0

        return out
